{
  "name": "dxcel-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.3.1 <27",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "supabase": "supabase",
    "db:start": "supabase start --exclude vector",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:lint": "supabase db lint --fail-on warning",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file .env.local",
    "lint": "deno lint --permit-no-files --config supabase/functions/deno.json",
    "format": "prettier --write . && deno fmt --config supabase/functions/deno.json",
    "format:check": "prettier --check . && deno fmt --check --config supabase/functions/deno.json",
    "check": "npm run lint && npm run format:check",
    "db:types": "sh scripts/generate-db-types.sh"
  },
  "devDependencies": {
    "deno": "2.9.6",
    "prettier": "3.9.10",
    "supabase": "3.0.0"
  },
  "allowScripts": {
    "deno@2.9.6": true
  }
}
